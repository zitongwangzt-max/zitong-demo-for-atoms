{
  "name": "folio-resume-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:editor",
    "dev": "python3 scripts/server.py --port 5173",
    "prebuild": "npm run build:editor",
    "build": "node scripts/build.mjs",
    "build:editor": "esbuild src/editor.mjs --bundle --platform=browser --format=iife --global-name=FolioEditor --minify --outfile=assets/editor.js",
    "preview": "python3 scripts/server.py --port 4173 --built"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "prettier": "^3.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
